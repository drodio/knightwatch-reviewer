[Unit]
Description=KnightWatch reviewer — containerized review fleet (docker compose)
# The review WORKERS run as docker containers (docker-compose.yml), unlike the
# pr-reviewer-* timers which are host scripts. Nothing brought the stack up at
# boot before this unit: the fleet relied solely on per-container `restart:`
# policy, which did NOT survive a host reboot — so a kernel-upgrade reboot left
# every reviewer Exited and silently stopped reviewing for hours. systemd now
# owns the stack lifecycle: `up` (recreating the dind+reviewer pairs in the right
# order) on boot, graceful `stop` on shutdown — covering reboot AND deploy.
# PartOf propagates docker.service's stop/restart to this unit: a bare
# `systemctl restart docker` (daemon upgrade / config reload) tears the
# containers down, and `Requires=` alone would NOT re-run them — only the
# reviewer containers carry `restart: unless-stopped`, and their dind sidecars
# carry none, so the fleet would strand. PartOf re-runs `stop`/`up -d` in tandem.
Requires=docker.service
PartOf=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=odio
Group=odio
# Deployed clone (~/services per the code-vs-deploy split) — the rendered
# compose file lives here, not in ~/.pr-reviewer. Host-specific by design,
# matching the /home/odio/ paths baked into the sibling units.
WorkingDirectory=/home/odio/services/knightwatch-reviewer
Environment=HOME=/home/odio
# PATH: system dirs FIRST, matching the sibling units — uniform security stance
# (no writable user dir searched ahead of /usr). ExecStart uses an absolute
# docker path, so this is belt-and-suspenders for any helper compose invokes.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# docker-compose.yml is generated from docker/secrets/fleet.conf and is NOT in
# git, so a `git pull` deploy leaves whatever the last render produced — or,
# on the migration commit that untracked it, nothing at all. Render before
# every up so the unit can never come up against a stale or absent topology.
# Invoked directly, not via `just`: this unit's PATH is system dirs only by
# design, and just lives under ~/.local/bin.
ExecStartPre=/bin/bash lib/render-compose.sh
# `compose up -d` returns once containers are started; RemainAfterExit keeps the
# unit active so ExecStop fires on shutdown/restart. --remove-orphans drops any
# service renamed/removed by a prior compose revision.
ExecStart=/usr/bin/docker compose up -d --remove-orphans
# Graceful stop on shutdown/restart — avoids the SIGKILL (exit 137) the reviewers
# took when the host reboot tore the daemon down underneath them. `stop` (not
# `down`) preserves containers/networks so the next `up` is fast. Self-healing:
# there's no ExecStopPre (systemd has no such directive), and a stop can land
# with no compose file on disk — right after a `git pull` deploy untracks it
# and before the next start's ExecStartPre has rendered it (reboot, or a bare
# `systemctl restart docker` mid-window). Without the render-if-absent guard,
# `docker compose stop` fails outright there and the containers take the exact
# SIGKILL this unit exists to prevent.
# Chained on success, not `;`: a `;` discards the render's exit status, so a
# FATAL (no fleet.conf) would be followed by compose's generic "no configuration
# file provided" — the render's actionable diagnostic replaced by a vaguer one.
ExecStop=/bin/bash -c '{ [ -f docker-compose.yml ] || bash lib/render-compose.sh; } && exec /usr/bin/docker compose stop'
# A first boot with images absent pulls docker:27-dind (and the reviewer image
# if not yet built by the deploy); give compose room before systemd calls the
# start a failure.
TimeoutStartSec=15min
StandardOutput=journal
StandardError=journal
SyslogIdentifier=knightwatch-reviewer

[Install]
WantedBy=multi-user.target
