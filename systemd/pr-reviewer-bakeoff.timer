[Unit]
Description=Plow PR reviewer specialist bake-off (twice nightly, 02:00 + 04:00 Pacific — split low-usage windows)

[Timer]
# Two fires in the dead of night, not one: the ~45-repo walk is the heaviest
# single consumer of the shared srosro GitHub budget, so WINDOW_HOURS=12 caps
# each run to a ~12h chunk and these two fires split the day's per-PR fetches
# into two smaller bursts (both off-hours, away from interactive sessions that
# hit secondary-rate-limit 403s). The walker advances the watermark by ≤12h per
# run and backfills missed crons, so the split stays lossless.
OnCalendar=*-*-* 02,04:00:00 America/Los_Angeles
Persistent=false
AccuracySec=1min
Unit=pr-reviewer-bakeoff.service

[Install]
WantedBy=timers.target
