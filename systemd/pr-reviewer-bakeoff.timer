[Unit]
Description=Plow PR reviewer specialist bake-off (once daily, 04:00 Pacific — low-usage window)

[Timer]
# Once daily in the dead of night, not 07:00+19:00: the ~45-repo walk is the
# heaviest single consumer of the shared srosro GitHub budget and the 19:00 run
# contended with interactive sessions (secondary-rate-limit 403s). The walker
# rewalks min(REWALK_HOURS=24h, last_walked_at) and backfills missed crons, so
# once-daily coverage is lossless. Move to a quieter hour if 04:00 PT gets busy.
OnCalendar=*-*-* 04:00:00 America/Los_Angeles
Persistent=false
AccuracySec=1min
Unit=pr-reviewer-bakeoff.service

[Install]
WantedBy=timers.target
